{
  "servers": {
    "workiq": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/workiq@1.0.0",
        "mcp",
        "--log-level",
        "Warning"
      ]
    },
    "ado-remote-mcp": {
      "type": "http",
      "url": "https://mcp.dev.azure.com/piemini",
      "headers": {
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "wit,wiki,work"
      }
    },
    "powerbi-remote": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/powerbi"
    },
    "icm-mcp": {
      "type": "http",
      "url": "https://icm-mcp-prod.azure-api.net/v1/"
    }
  }
}
